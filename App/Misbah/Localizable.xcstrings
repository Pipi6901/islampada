            "value": "Ayah pause"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقفة مع آية"
          }
        }
      }
    },
    "Показывает аят дня поверх приложения, которое вы открыли.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает аят дня поверх приложения, которое вы открыли."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the ayah of the day over the app you just opened."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض آية اليوم فوق التطبيق الذي فتحته للتو."
          }
        }
      }
    },
    "Пауза с аятом в ${applicationName}": {
