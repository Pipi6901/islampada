        }
      }
    },
    "Показывает стих дня поверх приложения, которое вы открыли.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает стих дня поверх приложения, которое вы открыли."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the verse of the day over the app you just opened."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Vers des Tages über der App, die Sie geöffnet haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le verset du jour par-dessus l’app que vous venez d’ouvrir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el versículo del día sobre la app que acabas de abrir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o versículo do dia sobre o app que você acabou de abrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il versetto del giorno sopra l’app che hai appena aperto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 연 앱 위에 오늘의 말씀을 보여 줘요."
          }
        }
      }
    },
