{
  "sourceLanguage": "ru",
  "strings": {
    "NSUserTrackingUsageDescription": {
      "comment": "Окно ATT: зачем Lampada просит разрешение на отслеживание",
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так мы узнаем, какая реклама Lampada в Instagram и Facebook привела тебя. Стихи и ответы не передаются."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tells us which Lampada ad on Instagram or Facebook brought you here. Verses and answers are never shared."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sehen wir, welche Lampada-Anzeige auf Instagram oder Facebook dich hergebracht hat. Verse und Antworten werden nicht weitergegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela nous indique quelle pub Lampada sur Instagram ou Facebook t’a amené ici. Les versets et les réponses ne sont jamais partagés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así sabremos qué anuncio de Lampada en Instagram o Facebook te trajo aquí. Los versículos y las respuestas no se comparten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim sabemos qual anúncio da Lampada no Instagram ou no Facebook trouxe você até aqui. Versículos e respostas nunca são compartilhados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così sappiamo quale annuncio di Lampada su Instagram o Facebook ti ha portato qui. I versetti e le risposte non vengono mai condivisi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram이나 Facebook의 어떤 Lampada 광고를 보고 오셨는지 알 수 있어요. 성경 구절과 답변은 공유되지 않아요."
          }
        }
      }
    }
  },
  "version": "1.0"
}
